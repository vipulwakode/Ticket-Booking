# Copy to .env and adjust. Never commit .env.

# --- Database ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing
DATABASE_URL=postgresql+psycopg://ticketing:ticketing@db:5432/ticketing
TEST_DATABASE_URL=postgresql+psycopg://ticketing:ticketing@db:5432/ticketing_test

# --- API ---
ENVIRONMENT=local
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# --- Razorpay (test mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
